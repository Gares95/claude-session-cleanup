{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gares95/claude-session-cleanup/schemas/preview-v1.json",
  "title": "session-cleanup preview report, version 1",
  "description": "Agent-neutral retention preview. Version 1 may gain optional fields; removing or redefining a field requires schema_version 2.",
  "type": "object",
  "required": ["schema", "schema_version", "agent", "tool", "mode", "read_only", "generated_at", "environment", "policy", "totals", "groups", "native_retention", "activity_detection", "mutation", "warnings"],
  "properties": {
    "schema": {"const": "session-cleanup/preview"},
    "schema_version": {"const": 1},
    "agent": {"type": "string", "enum": ["claude-code", "codex"]},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
    },
    "mode": {"const": "preview"},
    "read_only": {"type": "boolean"},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "environment": {
      "type": "object",
      "required": ["config_dir", "config_dir_source", "claude_code_versions_observed", "tested_claude_code_versions"],
      "properties": {
        "config_dir": {"type": "string"},
        "config_dir_source": {"type": "string", "enum": ["--config-dir", "CLAUDE_CONFIG_DIR", "default"]},
        "claude_code_versions_observed": {"type": "array", "items": {"type": "string"}},
        "tested_claude_code_versions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "policy": {
      "type": "object",
      "required": ["project", "older_than_seconds", "keep_latest", "min_idle_seconds", "combination", "ranking_unit", "action"],
      "properties": {
        "project": {
          "type": "object",
          "required": ["mode", "path"],
          "properties": {"mode": {"enum": ["current", "all"]}, "path": {"type": "string"}}
        },
        "older_than_seconds": {"type": ["integer", "null"], "minimum": 1},
        "keep_latest": {"type": ["integer", "null"], "minimum": 1},
        "min_idle_seconds": {"type": "integer", "minimum": 1},
        "combination": {"const": "intersection"},
        "ranking_unit": {"const": "root-session-group"},
        "action": {"type": ["string", "null"], "enum": [null, "archive", "quarantine", "delete"]}
      }
    },
    "totals": {
      "type": "object",
      "required": ["groups", "sessions", "bytes", "reasons"],
      "properties": {
        "groups": {"$ref": "#/$defs/statusCounts"},
        "sessions": {"$ref": "#/$defs/statusCounts"},
        "bytes": {"$ref": "#/$defs/statusCounts"},
        "reasons": {
          "type": "object",
          "required": ["selected", "protected", "excluded"],
          "properties": {
            "selected": {"type": "object", "additionalProperties": {"type": "integer"}},
            "protected": {"type": "object", "additionalProperties": {"type": "integer"}},
            "excluded": {"type": "object", "additionalProperties": {"type": "integer"}}
          }
        }
      }
    },
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "native_retention": {
      "type": "object",
      "required": ["disclaimer", "observed", "configured", "estimates"],
      "properties": {
        "disclaimer": {"type": "string"},
        "observed": {
          "type": "object",
          "required": ["last_cleanup_marker", "last_cleanup_marker_status", "basis"],
          "properties": {
            "last_cleanup_marker": {"$ref": "#/$defs/optionalTimestamp"},
            "last_cleanup_marker_status": {"enum": ["present", "missing", "invalid"]},
            "basis": {"type": "string"}
          }
        },
        "configured": {
          "type": "object",
          "required": ["default_days", "managed_days", "user_days", "applicable_days", "lowest_applicable_days", "sweep_may_pause", "sources", "complete", "limitations"],
          "properties": {
            "default_days": {"type": "integer"},
            "managed_days": {"type": ["integer", "null"]},
            "user_days": {"type": ["integer", "null"]},
            "applicable_days": {"type": "array", "items": {"type": "integer"}},
            "lowest_applicable_days": {"type": "integer", "minimum": 1},
            "sweep_may_pause": {"type": "boolean"},
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind", "path", "status", "value_days"],
                "properties": {
                  "kind": {"enum": ["managed-file", "managed-drop-in", "server-managed-cache", "user", "project-shared", "project-local"]},
                  "path": {"type": "string"},
                  "status": {"enum": ["set", "unset", "missing", "invalid", "unreadable"]},
                  "value_days": {"type": ["integer", "null"]}
                }
              }
            },
            "complete": {"type": "boolean"},
            "limitations": {"type": "array", "items": {"type": "string"}}
          }
        },
        "estimates": {
          "type": "object",
          "required": ["approaching_window_days", "groups_by_risk", "protected_groups_at_risk", "selected_groups_at_risk"],
          "properties": {
            "approaching_window_days": {"type": "integer"},
            "groups_by_risk": {
              "type": "object",
              "required": ["past-period", "approaching", "within-period"],
              "additionalProperties": false,
              "properties": {
                "past-period": {"type": "integer"},
                "approaching": {"type": "integer"},
                "within-period": {"type": "integer"}
              }
            },
            "protected_groups_at_risk": {"type": "integer"},
            "selected_groups_at_risk": {"type": "integer"}
          }
        }
      }
    },
    "activity_detection": {
      "type": "object",
      "required": ["complete", "invoking_session_id", "sources", "not_used", "limitations"],
      "properties": {
        "complete": {"type": "boolean"},
        "invoking_session_id": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"type": "object", "required": ["name"]}},
        "not_used": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "mutation": {
      "type": "object",
      "required": ["supported", "blockers"],
      "properties": {
        "supported": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "path"],
        "properties": {"code": {"type": "string"}, "path": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "optionalTimestamp": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "statusCounts": {
      "type": "object",
      "required": ["examined", "selected", "protected", "excluded"],
      "additionalProperties": false,
      "properties": {
        "examined": {"type": "integer", "minimum": 0},
        "selected": {"type": "integer", "minimum": 0},
        "protected": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0}
      }
    },
    "risk": {"enum": ["past-period", "approaching", "within-period"]},
    "group": {
      "type": "object",
      "required": ["group_id", "status", "reasons", "rank", "last_activity", "last_activity_evidence", "bytes", "session_count", "missing_links", "native_retention", "mutation_blockers", "sessions"],
      "properties": {
        "group_id": {"type": "string"},
        "status": {"enum": ["selected", "protected", "excluded"]},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "last_activity": {"$ref": "#/$defs/timestamp"},
        "last_activity_evidence": {
          "type": "object",
          "required": ["session_id", "source"],
          "properties": {"session_id": {"type": "string"}, "source": {"type": "string"}}
        },
        "bytes": {"type": ["integer", "null"], "minimum": 0},
        "session_count": {"type": "integer", "minimum": 1},
        "missing_links": {"type": "array", "items": {"type": "string"}},
        "native_retention": {
          "type": "object",
          "required": ["risk"],
          "properties": {"risk": {"$ref": "#/$defs/risk"}}
        },
        "mutation_blockers": {"type": "array", "items": {"type": "string"}},
        "sessions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/session"}}
      }
    },
    "reason": {
      "enum": [
        "older-than", "outside-latest",
        "invoking-session", "registered-running", "registered-possibly-running", "background-session-record",
        "recently-active", "within-latest", "newer-than-cutoff",
        "missing-cwd-evidence", "project-identity-unverified", "project-path-collision", "related-session-outside-project",
        "symlink-in-session", "non-regular-file", "foreign-owner", "unreadable", "empty-transcript", "unparseable-transcript", "duplicate-session-id"
      ]
    },
    "session": {
      "type": "object",
      "required": ["session_id", "role", "title", "title_source", "project", "created_at", "last_activity", "last_activity_source", "transcript", "bytes", "bytes_by_kind", "artifact_count", "subagent_count", "entrypoints", "claude_code_versions", "links", "issues", "warnings", "unknown_associated_artifacts", "native_retention"],
      "properties": {
        "session_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "role": {"enum": ["root", "linked"]},
        "title": {"type": ["string", "null"]},
        "title_source": {"type": ["string", "null"], "enum": [null, "custom-title", "custom-title-sidecar", "ai-title", "first-prompt", "last-prompt"]},
        "project": {
          "type": "object",
          "required": ["storage_dir", "identity", "path"],
          "properties": {
            "storage_dir": {"type": "string"},
            "identity": {"enum": ["verified", "unverified", "missing"]},
            "path": {"type": ["string", "null"]}
          }
        },
        "created_at": {"$ref": "#/$defs/optionalTimestamp"},
        "last_activity": {"$ref": "#/$defs/timestamp"},
        "last_activity_source": {"type": "string"},
        "transcript": {
          "type": "object",
          "required": ["modified_at", "bytes"],
          "properties": {"modified_at": {"$ref": "#/$defs/timestamp"}, "bytes": {"type": "integer", "minimum": 0}}
        },
        "bytes": {"type": "integer", "minimum": 0},
        "bytes_by_kind": {"type": "object", "additionalProperties": {"type": "integer"}},
        "artifact_count": {"type": "integer", "minimum": 0},
        "subagent_count": {"type": "integer", "minimum": 0},
        "entrypoints": {"type": "array", "items": {"type": "string"}},
        "claude_code_versions": {"type": "array", "items": {"type": "string"}},
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "session_id"],
            "properties": {"kind": {"enum": ["continued-in", "shared-session-data"]}, "session_id": {"type": "string"}}
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "path"],
            "properties": {"code": {"type": "string"}, "path": {"type": "string"}}
          }
        },
        "warnings": {"type": "array", "items": {"type": "string"}},
        "unknown_associated_artifacts": {"type": "array", "items": {"type": "string"}},
        "native_retention": {
          "type": "object",
          "required": ["transcript_modified_at", "risk"],
          "properties": {
            "transcript_modified_at": {"$ref": "#/$defs/timestamp"},
            "risk": {"$ref": "#/$defs/risk"}
          }
        }
      }
    }
  }
}
